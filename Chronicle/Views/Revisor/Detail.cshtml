@model Chronicle.Models.ViewModels.ArticleDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center py-5">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            @if (Model.Image != null)
            {
                <img src="@Model.Image.Path" class="w-100" style="max-height: 320px; object-fit: cover;" alt="" />
            }
            else
            {
                <img src="/images/default.jpg" class="w-100" style="max-height: 320px; object-fit: cover;" alt="" />
            }

            <div class="card-body p-5">
                <p class="text-muted small mb-2">
                    @(Model.Category?.Name ?? "No category") ·
                    @(Model.User?.UserName ?? "Removed user") ·
                    @Model.CreatedAt.ToString("dd/MM/yyyy")
                </p>

                <h1 class="h3 fw-bold mb-2">@Model.Title</h1>
                <p class="lead text-muted">@Model.Subtitle</p>

                <hr class="my-4" />

                <div style="white-space: pre-wrap;">@Model.Body</div>

                <div class="d-flex gap-2 mt-5">
                    <form asp-controller="Revisor" asp-action="SetAccepted" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="accepted" value="true" />
                        <button type="submit" class="btn btn-success">Accept</button>
                    </form>

                    <form asp-controller="Revisor" asp-action="SetAccepted" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="accepted" value="false" />
                        <button type="submit" class="btn btn-outline-danger">Reject</button>
                    </form>

                    <a asp-controller="Revisor" asp-action="Dashboard" class="btn btn-link text-muted text-decoration-none">Back to dashboard</a>
                </div>
            </div>
        </div>
    </div>
</div>